<ui:FluentWindow x:Class="ZeeVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
        xmlns:models="clr-namespace:ZeeVault.Models"
        xmlns:services="clr-namespace:ZeeVault.Services"
        Title="ZeeVault" Height="660" Width="960"
        MinHeight="660" MinWidth="960"
        Icon="app.ico"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Acrylic"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        Background="Transparent"
        ResizeMode="NoResize"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        SizeChanged="Window_SizeChanged">

    <ui:FluentWindow.Resources>

        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="0"
                                CornerRadius="6"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BtnBorder"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#44FFFFFF" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                     Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1.1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                     Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1.1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BtnBorder"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#22FFFFFF" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                     Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                     Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpinCloseButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="0"
                                CornerRadius="6"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="CloseBorder"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#FF4444" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="CloseBorder"
                                                     Storyboard.TargetProperty="(Border.RenderTransform).(RotateTransform.Angle)"
                                                     To="90" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="CloseBorder"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#22FFFFFF" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="CloseBorder"
                                                     Storyboard.TargetProperty="(Border.RenderTransform).(RotateTransform.Angle)"
                                                     To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                <Setter TargetName="border" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="Background" Value="#6366F1"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#6366F1" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <Grid>
                                <TextBlock Text="&#x2315;  Search..." Foreground="#3C4A5E" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#506366F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Context Menu Style -->
        <Style x:Key="AcrylicContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#F5202025"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Layout DataTemplate (Windows Start Menu style) -->
        <DataTemplate x:Key="CleanItemTemplate" DataType="{x:Type models:VaultItem}">
            <Border x:Name="CleanBorder"
                    Margin="4" Height="80"
                    CornerRadius="8"
                    Background="Transparent"
                    Cursor="Hand"
                    AllowDrop="True"
                    PreviewMouseLeftButtonDown="ItemCard_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ItemCard_PreviewMouseMove"
                    MouseLeftButtonUp="ItemCard_MouseLeftButtonUp"
                    DragOver="ItemCard_DragOver"
                    DragLeave="ItemCard_DragLeave"
                    Drop="ItemCard_Drop">
                <Border.ContextMenu>
                    <ContextMenu Style="{StaticResource AcrylicContextMenu}">
                        <MenuItem Header="&#x25B6; Launch" Click="MenuLaunch_Click" Tag="{Binding}"/>
                        <MenuItem Header="&#x1F4DD; Rename" Click="MenuRename_Click" Tag="{Binding}"/>
                        <MenuItem Header="&#x2699;&#xFE0F; Change Executable Target" Click="MenuChangePath_Click" Tag="{Binding}"/>
                        <MenuItem Header="&#x1F5BC;&#xFE0F; Change Icon..." Click="MenuChangeIcon_Click" Tag="{Binding}"/>
                        <MenuItem Header="&#x21BA; Reset Icon" Click="MenuResetIcon_Click" Tag="{Binding}"/>
                        <MenuItem Header="&#x1F4C1; Open File Location" Click="MenuOpenLocation_Click" Tag="{Binding}"/>
                        <MenuItem Header="&#x1F5D1;&#xFE0F; Remove from Vault" Click="MenuRemove_Click" Tag="{Binding}"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4">
                    <!-- Icon -->
                    <Border Width="36" Height="36" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Grid>
                            <Image Source="{Binding IconSource}" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                            <TextBlock Text="{Binding CategoryIcon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IconSource}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Title -->
                    <TextBlock x:Name="TxtTitleNameClean"
                               Text="{Binding Title}"
                               Foreground="#7A90A8"
                               FontSize="9"
                               FontWeight="Medium"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="100"/>
                </StackPanel>

                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="CleanBorder"
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#1CFFFFFF" Duration="0:0:0.12"/>
                                <ColorAnimation Storyboard.TargetName="TxtTitleNameClean"
                                    Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                    To="#E2E8F0" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Border.MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="CleanBorder"
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="Transparent" Duration="0:0:0.18"/>
                                <ColorAnimation Storyboard.TargetName="TxtTitleNameClean"
                                    Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                    To="#7A90A8" Duration="0:0:0.18"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
        </DataTemplate>

        <!-- Cards Layout DataTemplate (Full card style with details) -->
        <DataTemplate x:Key="CardsItemTemplate" DataType="{x:Type models:VaultItem}">
            <Border x:Name="CardBorder"
                    Margin="5" Height="100"
                    CornerRadius="10"
                    Background="#0AFFFFFF"
                    BorderBrush="#0EFFFFFF"
                    BorderThickness="1"
                    Cursor="Hand"
                    AllowDrop="True"
                    PreviewMouseLeftButtonDown="ItemCard_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ItemCard_PreviewMouseMove"
                    MouseLeftButtonUp="ItemCard_MouseLeftButtonUp"
                    DragOver="ItemCard_DragOver"
                    DragLeave="ItemCard_DragLeave"
                    Drop="ItemCard_Drop">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.4"/>
                </Border.Effect>
                <Border.ContextMenu>
                    <ContextMenu Style="{StaticResource AcrylicContextMenu}">
                        <MenuItem Header="&#x25B6; Launch" Click="MenuLaunch_Click" Tag="{Binding}"/>
                        <MenuItem Header="&#x1F4DD; Rename" Click="MenuRename_Click" Tag="{Binding}"/>
                        <MenuItem Header="&#x2699;&#xFE0F; Change Executable Target" Click="MenuChangePath_Click" Tag="{Binding}"/>
                        <MenuItem Header="&#x1F5BC;&#xFE0F; Change Icon..." Click="MenuChangeIcon_Click" Tag="{Binding}"/>
                        <MenuItem Header="&#x21BA; Reset Icon" Click="MenuResetIcon_Click" Tag="{Binding}"/>
                        <MenuItem Header="&#x1F4C1; Open File Location" Click="MenuOpenLocation_Click" Tag="{Binding}"/>
                        <MenuItem Header="&#x1F5D1;&#xFE0F; Remove from Vault" Click="MenuRemove_Click" Tag="{Binding}"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <!-- Category + Extension row -->
                    <Grid Grid.Row="0" Margin="5,4,5,0">
                        <Border HorizontalAlignment="Left" CornerRadius="4" Padding="3,1" Background="#1A6366F1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CategoryIcon}" FontSize="8" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <TextBlock Text="{Binding Category}" Foreground="#5B7A9A" FontSize="7.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border HorizontalAlignment="Right" CornerRadius="3" Padding="3,1" Background="#12FFFFFF">
                            <TextBlock Text="{Binding ExtensionDisplay}" Foreground="#3E5272" FontSize="7" FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <!-- Icon -->
                    <Border Grid.Row="1" Width="36" Height="36"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <Image Source="{Binding IconSource}" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                            <TextBlock Text="{Binding CategoryIcon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IconSource}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Title -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0">
                        <TextBlock x:Name="TxtTitleName"
                                   Text="{Binding Title}"
                                   Foreground="#7A90A8"
                                   FontSize="10"
                                   FontWeight="Medium"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="120"/>
                        <Border x:Name="Underline"
                                Height="1.5" Background="#6366F1"
                                Margin="0,2,0,0"
                                HorizontalAlignment="Center"
                                Width="0"/>
                    </StackPanel>
                </Grid>

                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="CardBorder"
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#1CFFFFFF" Duration="0:0:0.12"/>
                                <ColorAnimation Storyboard.TargetName="CardBorder"
                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                    To="#456366F1" Duration="0:0:0.12"/>
                                <ColorAnimation Storyboard.TargetName="TxtTitleName"
                                    Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                    To="#E2E8F0" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetName="Underline"
                                    Storyboard.TargetProperty="Width"
                                    To="34" Duration="0:0:0.18"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Border.MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="CardBorder"
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#08FFFFFF" Duration="0:0:0.18"/>
                                <ColorAnimation Storyboard.TargetName="CardBorder"
                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                    To="#0DFFFFFF" Duration="0:0:0.18"/>
                                <ColorAnimation Storyboard.TargetName="TxtTitleName"
                                    Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                    To="#7A90A8" Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetName="Underline"
                                    Storyboard.TargetProperty="Width"
                                    To="0" Duration="0:0:0.14"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
        </DataTemplate>

    </ui:FluentWindow.Resources>

    <Border x:Name="MainBorder" Background="#880A090F" BorderBrush="Transparent" BorderThickness="0" CornerRadius="10" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

                <ui:TitleBar Title="" ShowMaximize="False" ShowMinimize="False" ShowClose="False" Height="48" Padding="10,0">
                <ui:TitleBar.Header>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,18,0">
                            <Border Width="26" Height="26" CornerRadius="7" Background="#6366F1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#6366F1" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                                </Border.Effect>
                                <TextBlock Text="&#x26A1;" Foreground="White" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ZeeVault" Foreground="#E2E8F0" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Content="All" Style="{StaticResource TabButtonStyle}" IsChecked="True" Checked="Tab_Checked" Tag="All"/>
                            <RadioButton Content="&#x1F3AE; Games" Style="{StaticResource TabButtonStyle}" Checked="Tab_Checked" Tag="Games"/>
                            <RadioButton Content="&#x1F6E0; Tools" Style="{StaticResource TabButtonStyle}" Checked="Tab_Checked" Tag="Tools"/>
                            <RadioButton Content="&#x1F4C2; Files" Style="{StaticResource TabButtonStyle}" Checked="Tab_Checked" Tag="Files"/>
                        </StackPanel>

                        <TextBox x:Name="TxtSearch" Grid.Column="2" Width="175" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="TxtSearch_TextChanged" GotFocus="TxtSearch_GotFocus" PreviewMouseDown="TxtSearch_PreviewMouseDown"
                                 Margin="0,0,10,0"/>

                        <Button Content="+ Add" Grid.Column="3" Click="AddItem_Click" Padding="12,5" Background="#6366F1" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="7"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="SettingsBtn" Grid.Column="4" Style="{StaticResource WindowControlButton}" Content="&#x2699;" Click="SettingsBtn_Click" Margin="0,0,4,0" FontSize="16"/>

                        <Button Grid.Column="5" Style="{StaticResource WindowControlButton}" Content="&#x2500;" Click="MinimizeBtn_Click" FontSize="14" FontWeight="Bold" Margin="0,0,6,0"/>

                        <Button Grid.Column="6" Style="{StaticResource WindowControlButton}" Content="&#x25A1;" Click="MaximizeBtn_Click" FontSize="14" FontWeight="Bold" Margin="0,0,6,0"/>

                        <Button Grid.Column="7" Style="{StaticResource SpinCloseButton}" Content="&#x2715;" Click="CloseBtn_Click" Margin="0,0,8,0"/>
                    </Grid>
                </ui:TitleBar.Header>
            </ui:TitleBar>

            <!-- Update Available Banner -->
            <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed" Background="#256366F1" Padding="12,6">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x2191;" FontSize="12" Foreground="#A5B4FC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="UpdateBannerText" Text="Update available" Foreground="#E2E8F0" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="UpdateDownloadBtn" Content="Download" Click="UpdateDownload_Click"
                                Background="#6366F1" Foreground="White" FontSize="10.5" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand" Padding="10,3" Margin="0,0,6,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="UpdateDismissBtn" Content="Dismiss" Click="UpdateDismiss_Click"
                                Background="Transparent" Foreground="#A5B4FC" FontSize="10.5"
                                BorderThickness="1" BorderBrush="#406366F1" Cursor="Hand" Padding="10,3">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Download Progress Bar -->
            <Border x:Name="UpdateProgressBorder" Grid.Row="1" Visibility="Collapsed" Background="#256366F1" Padding="12,6">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateProgressText" Text="Downloading update..." Foreground="#E2E8F0" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="UpdateCancelBtn" Content="Cancel" Click="UpdateCancel_Click"
                            HorizontalAlignment="Right" Background="Transparent" Foreground="#A5B4FC" FontSize="10.5"
                            BorderThickness="1" BorderBrush="#406366F1" Cursor="Hand" Padding="10,3">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- Install Ready Banner -->
            <Border x:Name="InstallBanner" Grid.Row="1" Visibility="Collapsed" Background="#206366F1" Padding="12,6">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x2714;" FontSize="12" Foreground="#4ADE80" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Update downloaded and ready to install" Foreground="#E2E8F0" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="UpdateInstallBtn" Content="Install &amp; Restart" Click="UpdateInstall_Click"
                                Background="#22C55E" Foreground="White" FontSize="10.5" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand" Padding="10,3" Margin="0,0,6,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="UpdateLaterBtn" Content="Later" Click="UpdateDismiss_Click"
                                Background="Transparent" Foreground="#A5B4FC" FontSize="10.5"
                                BorderThickness="1" BorderBrush="#406366F1" Cursor="Hand" Padding="10,3">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="10,4,10,10">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <ItemsControl x:Name="ItemsGrid" VerticalAlignment="Top" ItemTemplate="{StaticResource CleanItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <!-- Drag & Drop Overlay -->
                <Border x:Name="DropOverlay" Background="#D2080710" CornerRadius="10"
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#x1F4E5;" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Drop items here to add to ZeeVault"
                                   Foreground="#E2E8F0" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Supports .exe, .lnk, .doc, .txt, .zip and any file"
                                   Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Smart Windows App Search Dropdown Popup -->
                <Popup x:Name="SearchDropdown"
                       PlacementTarget="{Binding ElementName=TxtSearch}"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       Focusable="False"
                       StaysOpen="False"
                       IsOpen="False">
                    <Border Padding="14" Background="Transparent">
                        <Border Background="#F0202025" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="10" Width="330" MaxHeight="360">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Popup Header -->
                                <Border Grid.Row="0" Background="#12FFFFFF" CornerRadius="9,9,0,0" Padding="14,10" BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚡" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="WINDOWS APP SEARCH" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtResultCount" Text="0 apps found" Foreground="#64748B" FontSize="9.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Results List -->
                                <Border Grid.Row="1" CornerRadius="0,0,9,9" ClipToBounds="True">
                                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" MaxHeight="300" Padding="4,4,4,6">
                                        <ItemsControl x:Name="SearchResultsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type services:WindowsAppSearchResult}">
                                                    <Border Margin="2,2" Padding="10,8" CornerRadius="8" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="SearchResult_Click">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#20FFFFFF"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="32"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- App Icon -->
                                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" Background="#12FFFFFF" VerticalAlignment="Center">
                                                                <Grid>
                                                                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                                                                    <TextBlock Text="⚡" FontSize="12" Foreground="#818CF8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Border>

                                                            <!-- App Name Only (No Subtitle / No AUMID / No GUID) -->
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#F8FAFC" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,6,0" TextTrimming="CharacterEllipsis"/>

                                                            <!-- Source Pill Badge -->
                                                            <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="5" Padding="6,2.5" Background="#206366F1">
                                                                <TextBlock Text="{Binding Source}" Foreground="#A5B4FC" FontSize="8.5" FontWeight="Bold"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </Border>
                </Popup>

                <!-- Settings Popup (dropdown below gear button) -->
                <Popup x:Name="SettingsPopup" PlacementTarget="{x:Reference SettingsBtn}"
                       Placement="Bottom" HorizontalOffset="-200" AllowsTransparency="True" PopupAnimation="None"
                       StaysOpen="True" Opened="SettingsPopup_Open" Closed="SettingsPopup_Closed">
                    <Border x:Name="SettingsPopupBorder" Background="#F0202025" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="10"
                            Padding="4" Margin="0,4" MinWidth="260"
                            RenderTransformOrigin="1,0">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="0"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Menu Items -->
                            <StackPanel x:Name="SettingsMenuItems" Grid.Row="0">
                                <!-- Check for Updates -->
                                <Border Cursor="Hand" MouseLeftButtonDown="CheckUpdate_Click"
                                        Padding="12,10" CornerRadius="8" Background="Transparent">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#20FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="#20FFFFFF" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     To="2" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="Border.MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="Transparent" Duration="0:0:0.2"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     To="0" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#x1F504;" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Check for Updates" Foreground="#F8FAFC" FontSize="12.5"/>
                                            <TextBlock x:Name="UpdateStatusText" Text="You're running the latest version" Foreground="#64748B" FontSize="10" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="&#x276F;" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Separator -->
                                <Border Height="1" Background="#15FFFFFF" Margin="8,2"/>

                                <!-- Layout -->
                                <Border x:Name="LayoutMenuItem" Cursor="Hand"
                                        Padding="12,10" CornerRadius="8" Background="Transparent"
                                        MouseEnter="LayoutMenu_Enter" MouseLeave="LayoutMenu_Leave">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#20FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="#20FFFFFF" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     To="2" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="Border.MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="Transparent" Duration="0:0:0.2"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     To="0" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#x1F5BC;" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="Layout" Foreground="#F8FAFC" FontSize="12.5" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="&#x276F;" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Separator -->
                                <Border Height="1" Background="#15FFFFFF" Margin="8,2"/>

                                <!-- Set Password -->
                                <Border x:Name="PasswordMenuItem" Cursor="Hand"
                                        Padding="12,10" CornerRadius="8" Background="Transparent"
                                        MouseEnter="PasswordMenu_Enter" MouseLeave="PasswordMenu_Leave">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#20FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="#20FFFFFF" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     To="2" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="Border.MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="Transparent" Duration="0:0:0.2"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     To="0" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#x1F512;" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="Set Password" Foreground="#F8FAFC" FontSize="12.5" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="&#x276F;" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Close on Launch -->
                                <Border x:Name="CloseOnLaunchMenuItem" Cursor="Hand"
                                        Padding="12,10" CornerRadius="8" Background="Transparent"
                                        MouseEnter="CloseOnLaunchMenu_Enter" MouseLeave="CloseOnLaunchMenu_Leave">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#20FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="#20FFFFFF" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     To="2" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="Border.MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="Transparent" Duration="0:0:0.2"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     To="0" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#x1F51A;" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Close on Launch" Foreground="#F8FAFC" FontSize="12.5"/>
                                            <TextBlock x:Name="CloseOnLaunchStatus" Text="Enabled" Foreground="#64748B" FontSize="10" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="&#x276F;" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Separator -->
                                <Border Height="1" Background="#15FFFFFF" Margin="8,2"/>

                                <!-- About -->
                                <Border Cursor="Hand" MouseLeftButtonDown="About_Click"
                                        Padding="12,10" CornerRadius="8" Background="Transparent">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#20FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="#20FFFFFF" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     To="2" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="Border.MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="Transparent" Duration="0:0:0.2"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     To="0" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#x2139;" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="About ZeeVault" Foreground="#F8FAFC" FontSize="12.5" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="&#x276F;" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Inline About Panel -->
                            <StackPanel x:Name="AboutInlinePanel" Grid.Row="1" Visibility="Collapsed">
                                <Border Height="1" Background="#15FFFFFF" Margin="8,4"/>
                                <StackPanel Margin="8,4">
                                    <TextBlock Text="ZeeVault" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" Margin="4,0,0,6"/>
                                    <Border Background="#206366F1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="4,0,0,10">
                                        <TextBlock x:Name="AboutInlineVersionText" Text="Version 1.0.0" Foreground="#A5B4FC" FontSize="9.5" FontWeight="SemiBold"/>
                                    </Border>
                                    <Grid Margin="4,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Author" Foreground="#64748B" FontSize="10" Margin="0,0,0,5"/>
                                        <TextBlock Grid.Column="1" Text="Charlotte Zee" Foreground="#CBD5E1" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    </Grid>
                                    <Grid Margin="4,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="License" Foreground="#64748B" FontSize="10" Margin="0,0,0,5"/>
                                        <TextBlock Grid.Column="1" Text="Personal Use &amp; Modification" Foreground="#CBD5E1" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    </Grid>
                                    <Grid Margin="4,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Framework" Foreground="#64748B" FontSize="10" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Column="1" Text=".NET 10 / WPF" Foreground="#CBD5E1" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    </Grid>
                                    <Border Height="1" Background="#15FFFFFF" Margin="0,0,0,8"/>
                                    <Button Content="&#x1F517;  View on GitHub" Click="AboutGitHub_Click"
                                            Background="#6366F1" Foreground="White" FontWeight="SemiBold" FontSize="10"
                                            BorderThickness="0" Cursor="Hand" Padding="10,5" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" Margin="0,0,0,4">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button x:Name="AboutBackBtn" Content="&#x25C0;  Back" Click="AboutBack_Click"
                                            Background="Transparent" Foreground="#64748B" FontWeight="SemiBold" FontSize="10"
                                            BorderThickness="1" BorderBrush="#15FFFFFF" Cursor="Hand" Padding="10,5"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Popup>

                <!-- Layout Submenu Popup (appears to the right of Layout option) -->
                <Popup x:Name="LayoutSubmenuPopup" PlacementTarget="{x:Reference LayoutMenuItem}"
                       Placement="Right" HorizontalOffset="-4" AllowsTransparency="True"
                       StaysOpen="True" IsOpen="False"
                       MouseEnter="LayoutSubmenu_Enter" MouseLeave="LayoutSubmenu_Leave">
                    <Border x:Name="LayoutSubmenuBorder" Background="#F0202025" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="10"
                            Padding="4" MinWidth="140">
                        <StackPanel>
                            <!-- Clean Style -->
                            <Border Cursor="Hand" MouseLeftButtonDown="LayoutClean_Click"
                                    Padding="10,7" CornerRadius="8" Background="Transparent">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Border.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#30FFFFFF" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="Border.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="Transparent" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#x25CB;" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Clean" Foreground="#F8FAFC" FontSize="11.5" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LayoutCleanCheck" Grid.Column="2" Text="&#x2713;" Foreground="#6366F1" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <!-- Cards Style -->
                            <Border Cursor="Hand" MouseLeftButtonDown="LayoutCards_Click"
                                    Padding="10,7" CornerRadius="8" Background="Transparent">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Border.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#30FFFFFF" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="Border.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="Transparent" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#x25A3;" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Cards" Foreground="#F8FAFC" FontSize="11.5" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LayoutCardsCheck" Grid.Column="2" Text="&#x2713;" Foreground="#6366F1" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Set Password Submenu Popup -->
                <Popup x:Name="PasswordSubmenuPopup" PlacementTarget="{x:Reference PasswordMenuItem}"
                       Placement="Right" HorizontalOffset="-4" AllowsTransparency="True"
                       StaysOpen="True" IsOpen="False"
                       MouseEnter="PasswordSubmenu_Enter" MouseLeave="PasswordSubmenu_Leave">
                    <Border Background="#F0202025" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="10"
                            Padding="4" MinWidth="140">
                        <StackPanel>
                            <!-- New Password -->
                            <Border Cursor="Hand" MouseLeftButtonDown="PasswordNew_Click"
                                    Padding="10,7" CornerRadius="8" Background="Transparent">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Border.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#30FFFFFF" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="Border.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="Transparent" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#x2795;" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="New Password" Foreground="#F8FAFC" FontSize="11.5" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PasswordNewCheck" Grid.Column="2" Text="&#x2713;" Foreground="#6366F1" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <!-- Disable -->
                            <Border Cursor="Hand" MouseLeftButtonDown="PasswordDisable_Click"
                                    Padding="10,7" CornerRadius="8" Background="Transparent">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Border.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#30FFFFFF" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="Border.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="Transparent" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#x2716;" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Disable" Foreground="#F8FAFC" FontSize="11.5" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PasswordDisableCheck" Grid.Column="2" Text="&#x2713;" Foreground="#6366F1" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Close on Launch Submenu Popup -->
                <Popup x:Name="CloseOnLaunchSubmenuPopup" PlacementTarget="{x:Reference CloseOnLaunchMenuItem}"
                       Placement="Right" HorizontalOffset="-4" AllowsTransparency="True"
                       StaysOpen="True" IsOpen="False"
                       MouseEnter="CloseOnLaunchSubmenu_Enter" MouseLeave="CloseOnLaunchSubmenu_Leave">
                    <Border Background="#F0202025" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="10"
                            Padding="4" MinWidth="140">
                        <StackPanel>
                            <!-- Enable -->
                            <Border Cursor="Hand" MouseLeftButtonDown="CloseOnLaunchEnable_Click"
                                    Padding="10,7" CornerRadius="8" Background="Transparent">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Border.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#30FFFFFF" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="Border.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="Transparent" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#x25CB;" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Enable" Foreground="#F8FAFC" FontSize="11.5" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CloseOnLaunchEnableCheck" Grid.Column="2" Text="&#x2713;" Foreground="#6366F1" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Disable -->
                            <Border Cursor="Hand" MouseLeftButtonDown="CloseOnLaunchDisable_Click"
                                    Padding="10,7" CornerRadius="8" Background="Transparent">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Border.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#30FFFFFF" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="Border.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="Transparent" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#x25CB;" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Disable" Foreground="#F8FAFC" FontSize="11.5" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CloseOnLaunchDisableCheck" Grid.Column="2" Text="&#x2713;" Foreground="#6366F1" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Add from Search Popup Modal -->
                <Border x:Name="AddFromSearchPopup" Visibility="Collapsed" Background="#CC0A090F"
                        CornerRadius="12" IsHitTestVisible="True" MouseLeftButtonDown="AddFromSearchPopup_Background_Click">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="380"
                            Background="#1A1830" BorderBrush="#2A2740" BorderThickness="1" CornerRadius="12"
                            Padding="0" Margin="20">
                        <Border.Effect>
                            <DropShadowEffect Color="#6366F1" BlurRadius="24" ShadowDepth="0" Opacity="0.3"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0" Background="#12FFFFFF" CornerRadius="12,12,0,0" Padding="16,12">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="32" Height="32" CornerRadius="8" Background="#6366F1" Margin="0,0,10,0">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#6366F1" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                            </Border.Effect>
                                            <TextBlock Text="&#x2795;" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="PopupAppName" Text="Add App" Foreground="#E2E8F0" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock x:Name="PopupAppPath" Text="" Foreground="#5B7A9A" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Content="&#x2715;" HorizontalAlignment="Right" Click="AddFromSearchPopup_Close"
                                            Background="Transparent" Foreground="#64748B" FontSize="14" Cursor="Hand"
                                            BorderThickness="0" Padding="4"/>
                                </Grid>
                            </Border>

                            <!-- Content -->
                            <StackPanel Grid.Row="1" Margin="20,16">
                                <!-- App Icon Preview -->
                                <Border HorizontalAlignment="Center" Width="56" Height="56" CornerRadius="10" Background="#12FFFFFF" Margin="0,0,0,14">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#6366F1" BlurRadius="12" ShadowDepth="0" Opacity="0.3"/>
                                    </Border.Effect>
                                    <Image x:Name="PopupAppIcon" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                                </Border>

                                <!-- Title Input -->
                                <TextBlock Text="APP NAME" Foreground="#5B7A9A" FontSize="9" FontWeight="Bold" Margin="0,0,0,6"/>
                                <Border Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Margin="0,0,0,14">
                                    <TextBox x:Name="PopupTitleInput" Background="Transparent" Foreground="#E2E8F0"
                                             BorderThickness="0" Padding="10,8" FontSize="13" CaretBrush="#6366F1"/>
                                </Border>

                                <!-- Category Selector -->
                                <TextBlock Text="CATEGORY" Foreground="#5B7A9A" FontSize="9" FontWeight="Bold" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="PopupCatGames" Grid.Column="0" Content="&#x1F3AE; Games"
                                                 Style="{StaticResource TabButtonStyle}" Tag="Games" IsChecked="True"/>
                                    <RadioButton x:Name="PopupCatTools" Grid.Column="1" Content="&#x1F6E0; Tools"
                                                 Style="{StaticResource TabButtonStyle}" Tag="Tools"/>
                                    <RadioButton x:Name="PopupCatFiles" Grid.Column="2" Content="&#x1F4C2; Files"
                                                 Style="{StaticResource TabButtonStyle}" Tag="Files"/>
                                </Grid>
                            </StackPanel>

                            <!-- Footer Button -->
                            <Border Grid.Row="2" Padding="20,0,20,16">
                                <Button Content="&#x2795;  Add to ZeeVault" Click="AddFromSearchPopup_Confirm"
                                        Padding="16,10" Background="#6366F1" Foreground="White" FontWeight="Bold" FontSize="13"
                                        BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Border>
                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
